{
  "qrf-stop-gate": {
    "Stop": [
      { "type": "command", "command": "node ../scripts/harness/stop-gate.mjs", "timeout": 300 }
    ]
  },
  "qrf-cmd-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "node ../scripts/harness/cmd-guard.mjs", "timeout": 10 }]
      }
    ]
  },
  "qrf-post-tool": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node ../scripts/harness/post-tool.mjs", "timeout": 40 }]
      }
    ]
  }
}
